{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "./",
    "outDir": "dist",
    "incremental": true,
    "paths": {
      "@hodfords/env-parser": ["./lib/index.ts"]
    }
  },
  "include": [
    "lib",
    "sample"
  ],
  "exclude": [
    "tests",
    "dist",
    "node_modules"
  ]
}
